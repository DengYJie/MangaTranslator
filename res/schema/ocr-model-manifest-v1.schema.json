{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OcrModelManifest",
  "description": "Manifest schema for Baberu OCR ONNX model packages (version 1).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "id",
    "version",
    "source",
    "runtime",
    "graphs",
    "tokenizer",
    "input",
    "normalization",
    "generation",
    "postprocess"
  ],
  "properties": {
    "manifestVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "license"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "license": { "type": "string", "minLength": 1 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumOnnxRuntime", "opset", "executionProvider"],
      "properties": {
        "minimumOnnxRuntime": {
          "type": "string",
          "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
        },
        "opset": {
          "type": "integer",
          "minimum": 1
        },
        "executionProvider": {
          "type": "string",
          "enum": ["cpu"]
        }
      }
    },
    "graphs": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "file", "sha256", "inputs", "outputs"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["vision", "decoder-prefill", "decoder-step"]
          },
          "file": {
            "type": "string",
            "pattern": "^[^/\\\\:*?\"<>|][^:*?\"<>|]*\\.onnx$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "tokenizer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "vocabFile", "sha256", "bosTokenId", "eosTokenId", "padTokenId", "unkTokenId"],
      "properties": {
        "type": {
          "type": "string",
          "const": "baberu-character-v1"
        },
        "vocabFile": {
          "type": "string",
          "pattern": "^[^/\\\\:*?\"<>|][^:*?\"<>|]*\\.json$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bosTokenId": { "type": "integer", "minimum": 1 },
        "eosTokenId": { "type": "integer", "minimum": 1 },
        "padTokenId": { "type": "integer", "minimum": 0 },
        "unkTokenId": { "type": "integer", "minimum": 0 }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "layout", "color", "sourceConversion", "resizeMode", "resample"],
      "properties": {
        "width":  { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "layout": { "type": "string", "enum": ["NCHW"] },
        "color":  { "type": "string", "enum": ["RGB"] },
        "sourceConversion": { "type": "string", "minLength": 1 },
        "resizeMode": { "type": "string", "minLength": 1 },
        "resample":   { "type": "string", "minLength": 1 }
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scale", "mean", "std"],
      "properties": {
        "scale": { "type": "number", "exclusiveMinimum": 0 },
        "mean": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "number" }
        },
        "std": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxLength", "strategy", "repetitionPenalty", "contentRunCap"],
      "properties": {
        "maxLength":         { "type": "integer", "minimum": 1 },
        "strategy":         { "type": "string", "enum": ["greedy"] },
        "repetitionPenalty":{ "type": "number", "minimum": 1.0 },
        "contentRunCap":    { "type": "integer", "minimum": 1 }
      }
    },
    "postprocess": {
      "type": "string",
      "const": "baberu-v1"
    }
  }
}
